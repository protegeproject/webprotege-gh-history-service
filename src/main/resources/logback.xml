<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Mute just this class -->
    <logger name="org.obolibrary.oboformat.parser.OBOFormatParser" level="OFF" additivity="false"/>

    <!-- (Optional) If you *also* want the whole package muted, keep this.
         Otherwise delete it to avoid over-silencing. -->
    <!-- <logger name="org.obolibrary.oboformat.parser" level="OFF" additivity="false"/> -->

    <!-- Root logging ON -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
